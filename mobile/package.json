{
  "name": "clinicflow-mobile",
  "version": "1.0.0-rc.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "audit:production": "node scripts/audit-production.mjs",
    "validate:release-metadata": "node scripts/validate-release-metadata.mjs",
    "validate:android-security": "node scripts/validate-android-security.mjs",
    "validate:merged-android-security": "node scripts/validate-merged-android-manifest.mjs",
    "test": "node --test __tests__/**/*.test.js",
    "postinstall": "patch-package"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-keep-awake"
      ]
    }
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "^9.2.1",
    "@reduxjs/toolkit": "^2.9.0",
    "expo": "57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~6.0.3"
  }
}
