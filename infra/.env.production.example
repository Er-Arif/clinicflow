CLINICFLOW_DOMAIN=clinic.example.com
CLINICFLOW_ALLOWED_HOSTS='["clinic.example.com","127.0.0.1"]'
CLINICFLOW_CORS_ORIGINS='[]'
# Matches Caddy's fixed backend-network IP in docker-compose.production.yml.
CLINICFLOW_TRUSTED_PROXY_IPS='["172.30.0.10/32"]'
CLINICFLOW_CLIENT_IP_SOURCE=socket
CLINICFLOW_DB_POOL_SIZE=5
CLINICFLOW_DB_MAX_OVERFLOW=5
CLINICFLOW_DB_POOL_TIMEOUT=10
CLINICFLOW_DB_POOL_RECYCLE=1800
CLINICFLOW_DB_CONNECT_TIMEOUT=5
CLINICFLOW_CLINIC_TIMEZONE=Asia/Kolkata
CLINICFLOW_LOG_LEVEL=INFO
CLINICFLOW_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
CLINICFLOW_ACCESS_TOKEN_MINUTES=15
CLINICFLOW_REFRESH_SESSION_DAYS=30
CLINICFLOW_APP_VERSION=0.1.0
CLINICFLOW_BUILD_COMMIT=replace-with-release-git-commit
CLINICFLOW_MINIMUM_MOBILE_VERSION=0.1.0
CLINICFLOW_LATEST_MOBILE_VERSION=0.1.0

POSTGRES_DB=clinicflow
POSTGRES_USER=clinicflow
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# URL-encode special characters in the password when building this URL.
CLINICFLOW_DATABASE_URL=postgresql+psycopg://clinicflow:replace-with-url-encoded-password@postgres:5432/clinicflow
